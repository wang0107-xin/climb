# 绝对不能进镜像：.env 里有 SECRET_KEY / 数据库地址
# 容器运行时通过 K8s 的 env / Secret 注入（见 k8s/main/k8s.yaml、k8s/qa/app.yaml）
.env
.env.*

# 本地虚拟环境、缓存、IDE
.venv
venv
env
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.idea
*.iml

# 本地开发数据库与抓取产物，不要把开发数据打进镜像
instance
data

# 测试与流水线脚本：只在 Jenkins 的 pod 里跑，没必要进运行镜像
tests
ci
docs
pytest.ini
ruff.toml
requirements-dev.txt
reports
.coverage

# 部署清单由 kubectl 直接读文件，不经过镜像（一条 k8s 就够，整个目录都排除了）
k8s

# 与运行无关的仓库文件
.git
.gitignore
Jenkinsfile
*.http
*.md
