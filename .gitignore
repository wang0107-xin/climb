# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- 密钥与环境变量 ----
# 注意：.env 已经被 git 跟踪了，加进 .gitignore 不会自动取消跟踪，
# 需要执行一次： git rm --cached .env
.env
.env.*

# ---- 数据库（本地开发数据，不该进仓库）----
*.db
*.sqlite3
instance/

# ---- 抓取产物 ----
# 本地跑一次抓取就会在 data/ 下堆一个 CSV，不挡一下 git status 就没法看了。
# 已经跟踪的样例文件（data/douban_20260506_1648.csv）不受影响，会继续留在仓库里。
data/*.csv

# ---- IDE ----
.idea/
*.iml

# ---- 构建产物 ----
build/
dist/
*.log

# ---- 流水线产物（Jenkins 去归档，不进仓库）----
reports/
.coverage
